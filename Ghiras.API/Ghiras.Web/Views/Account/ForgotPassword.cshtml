@{
    Layout = "_Layout";
    ViewData["Title"] = "استعادة كلمة المرور";
    ViewData["IsAuthPage"] = true;
}

<div class="d-flex justify-content-center align-items-center vh-100" style="background-color: #edf4ef;">
    <div class="card-xd shadow-lg d-flex flex-row p-0 overflow-hidden" style="width: 950px; height: 550px; border-radius: 28px;">
        <div class="col-6 p-5 d-flex flex-column justify-content-center bg-white">
            <h3 class="fw-bold mb-2 fs-2">استعادة كلمة المرور</h3>
            <p class="text-muted fs-6 mb-4">أدخل بريدك الإلكتروني وسيصلك رابط إعادة التعيين</p>

            <form asp-action="Login" method="get">
                <div class="mb-4">
                    <label class="form-label fw-bold">البريد الإلكتروني</label>
                    <input type="email" class="form-control form-control-lg fs-6 rounded-3" placeholder="admin@geiras.com" required>
                </div>
                <button type="submit" class="btn btn-green-xd w-100 py-3 fs-5 mb-3">إرسال رابط التعيين</button>
                <div class="text-center">
                    <a asp-action="Login" class="text-decoration-none text-muted fw-bold">العودة لتسجيل الدخول</a>
                </div>
            </form>
        </div>
        <div class="col-6 d-flex flex-column justify-content-center align-items-center text-center p-5" style="border-right: 1px solid #e2e8f0; background: #fafdfa;">
            <div class="leaf-loader" style="animation: none; width: 100px; height: 100px;"></div>
            <h1 class="fw-bold fs-2 text-success mt-3">GEIRAS | غراس</h1>
        </div>
    </div>
</div>