@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول - غراس";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #1b5e20 0%, #2e7d32 100%);
            font-family: 'Cairo', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-card {
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 440px;
            padding: 40px;
        }

        .btn-ghiras {
            background: linear-gradient(135deg, #2e7d32, #1b5e20);
            color: #ffffff;
            border: none;
            padding: 12px;
            border-radius: 12px;
            font-weight: 700;
            width: 100%;
        }

        .btn-ghiras:hover {
            background: linear-gradient(135deg, #1b5e20, #0d3b10);
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="login-card text-center">
        <div class="mb-3">
            <img src="/images/logo.svg" alt="شعار غراس" style="width: 90px; height: 90px;">
        </div>

        <h3 class="fw-extrabold text-dark mb-1">منصة غراس | GEIRAS</h3>
        <p class="text-muted small mb-4">تسجيل الدخول للوحة تحكم إدارة الزراعة والذكاء الاصطناعي</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger p-2 small mb-3">@ViewBag.Error</div>
        }

        <form asp-action="LoginSubmit" method="post" class="text-start">
            <div class="mb-3">
                <label class="form-label fw-bold small text-dark">البريد الإلكتروني</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                    <input type="email" name="email" class="form-control border-start-0 ps-0" placeholder="admin@ghiras.sa" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold small text-dark">كلمة المرور</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
                    <input type="password" name="password" class="form-control border-start-0 ps-0" placeholder="••••••••" required>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label small text-muted" for="rememberMe">تذكرني</label>
                </div>
                <a href="/Account/ForgotPassword" class="small text-success fw-bold text-decoration-none">نسيت كلمة المرور؟</a>
            </div>

            <button type="submit" class="btn btn-ghiras py-3 fw-bold mb-3">
                تسجيل الدخول <i class="fa-solid fa-arrow-left ms-2"></i>
            </button>

            <div class="text-center pt-2 border-top">
                <span class="small text-muted">ليس لديك حساب؟</span>
                <a href="/Account/Register" class="small text-success fw-bold text-decoration-none ms-1">إنشاء حساب جديد</a>
            </div>
        </form>
    </div>
</body>
</html>