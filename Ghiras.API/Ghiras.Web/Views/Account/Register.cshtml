@model Ghiras.Web.Models.UserViewModel
@{
    Layout = null;
    ViewData["Title"] = "إنشاء حساب جديد - غراس";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #1b5e20 0%, #2e7d32 100%);
            font-family: 'Cairo', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .register-card {
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 480px;
            padding: 40px;
        }

        .btn-ghiras {
            background: linear-gradient(135deg, #2e7d32, #1b5e20);
            color: #ffffff;
            border: none;
            padding: 12px;
            border-radius: 12px;
            font-weight: 700;
            width: 100%;
        }

        .btn-ghiras:hover {
            background: linear-gradient(135deg, #1b5e20, #0d3b10);
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="register-card text-center">
        <div class="mb-3">
            <img src="/images/logo.svg" alt="شعار غراس" style="width: 80px; height: 80px;">
        </div>

        <h3 class="fw-extrabold text-dark mb-1">إنشاء حساب جديد في غراس</h3>
        <p class="text-muted small mb-4">انضم إلى منظومة غراس لإدارة المزروعات وفحص الأمراض بالذكاء الاصطناعي</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger p-2 small mb-3">@ViewBag.Error</div>
        }

        <form asp-action="RegisterSubmit" method="post" class="text-start">
            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-bold small text-dark"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-user text-muted"></i></span>
                    <input asp-for="Username" class="form-control border-start-0 ps-0" placeholder="أدخل اسمك الكامل" required>
                </div>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold small text-dark"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                    <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="example@ghiras.sa" required>
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-bold small text-dark"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
                    <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" required>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Role" class="form-label fw-bold small text-dark"></label>
                <select asp-for="Role" class="form-select">
                    <option value="مستخدم رئيسي">مستخدم (زارع / مهتم)</option>
                    <option value="مشرف زراعي">مشرف زراعي خبير</option>
                </select>
            </div>

            <button type="submit" class="btn btn-ghiras py-3 fw-bold mb-3">
                <i class="fa-solid fa-user-plus me-1"></i> إنشاء الحساب الان
            </button>

            <div class="text-center pt-2 border-top">
                <span class="small text-muted">لديك حساب بالفعل؟</span>
                <a href="/Account/Login" class="small text-success fw-bold text-decoration-none ms-1">تسجيل الدخول</a>
            </div>
        </form>
    </div>
</body>
</html>
