@model Ghiras.Web.Models.PlantViewModel
@{
    ViewData["Title"] = "تعديل بيانات النبتة";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-custom p-4 p-md-5">
            <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
                <div>
                    <h4 class="fw-bold m-0 text-dark"><i class="fa-solid fa-pen-to-square text-success me-2"></i> تعديل بيانات النبتة</h4>
                    <p class="text-muted small m-0">تحديث بيانات وإرشادات النبتة #@Model.PlantId</p>
                </div>
                <a href="/Plant/Index" class="btn btn-light border">إلغاء وعودة</a>
            </div>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="PlantId" />
                <input type="hidden" asp-for="ImageUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="PlantName" class="form-label fw-bold"></label>
                        <input asp-for="PlantName" class="form-control py-2">
                        <span asp-validation-for="PlantName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ScientificName" class="form-label fw-bold"></label>
                        <input asp-for="ScientificName" class="form-control py-2">
                        <span asp-validation-for="ScientificName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-bold"></label>
                        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select py-2"></select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ImageFile" class="form-label fw-bold">تغيير الصورة (اختياري)</label>
                        <input asp-for="ImageFile" type="file" class="form-control py-2" accept="image/*">
                    </div>

                    <div class="col-12">
                        <label asp-for="CareInstructions" class="form-label fw-bold"></label>
                        <textarea asp-for="CareInstructions" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="CareInstructions" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top text-end">
                    <button type="submit" class="btn btn-ghiras px-5 py-2">
                        <i class="fa-solid fa-save"></i> حفظ التغييرات
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
